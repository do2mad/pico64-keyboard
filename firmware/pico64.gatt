// Pico64 Keyboard – BLE GATT database
// Same service and characteristics as the BT-64 "BLE keyboard service" (protocol v1),
// so the Blue-64 Keyboard iOS app works unchanged. C64B0005 is a Pico64 extension.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Pico64"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

PRIMARY_SERVICE, C64B0001-B1E6-4A64-9C64-6B7E3F1A2D00

// Key state: [flags, key]  flags bit0 SHIFT, bit1 C=, bit2 CTRL, bit3 RESTORE
//                          key = PA*8 + PB (0..63), 0xFF = none
CHARACTERISTIC, C64B0002-B1E6-4A64-9C64-6B7E3F1A2D00, WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,

// Text feed: byte0 bit0 first chunk, bit1 last chunk; then text in BT-64 macro syntax
CHARACTERISTIC, C64B0003-B1E6-4A64-9C64-6B7E3F1A2D00, WRITE | DYNAMIC,

// Info: [protocol version, status (bit0 text feed busy), capabilities (bit0 full matrix)]
CHARACTERISTIC, C64B0004-B1E6-4A64-9C64-6B7E3F1A2D00, READ | DYNAMIC,

// Pico64 extension – full matrix: [flags, col0, col1, ... col7]
//   col n = bit mask of the PB rows pressed in PA column n (any number of keys)
CHARACTERISTIC, C64B0005-B1E6-4A64-9C64-6B7E3F1A2D00, WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,
